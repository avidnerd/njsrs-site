rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data != null ? userDoc.data.role : null;
    }

    function isAdmin() {
      let role = getUserRole();
      return role == 'fair_director' || role == 'website_manager';
    }

    function isSRA() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/sras/$(request.auth.uid)).data != null;
    }

    function isUpdatingTeamMember(userId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/students/$(request.auth.uid)).data.teamMemberUserId == userId;
    }

    function isPrimaryStudentOfTeamMember(userId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/students/$(request.auth.uid)).data.teamMemberUserId == userId;
    }

    function hasJudgingAssignmentToStudent(studentId) {
      let categoryDocId = 'category_' + request.auth.uid + '_' + studentId;
      let finalDocId = 'final_' + request.auth.uid + '_' + studentId;
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/judgingAssignments/$(categoryDocId)) ||
        exists(/databases/$(database)/documents/judgingAssignments/$(finalDocId))
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isPrimaryStudentOfTeamMember(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isUpdatingTeamMember(userId) || isAdmin();
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /sras/{sraId} {
      allow read: if true;
      allow create: if isOwner(sraId);
      allow update: if isOwner(sraId) || isAdmin();
    }

    match /students/{studentId} {
      function isTeamMember() {
        return isAuthenticated() &&
               resource.data.teamMemberUserId == request.auth.uid;
      }

      allow read: if isOwner(studentId) ||
                     isTeamMember() ||
                     isSRA() ||
                     isAdmin() ||
                     hasJudgingAssignmentToStudent(studentId) ||
                     getUserRole() == 'judge';
      allow create: if isAuthenticated() && request.auth.uid == studentId;
      allow update: if isOwner(studentId) ||
                        isTeamMember() ||
                        (isSRA() && resource.data.sraId == request.auth.uid) ||
                        isAdmin();
      allow list: if isAuthenticated() && (getUserRole() == 'student' || isSRA() || isAdmin() || getUserRole() == 'judge');
    }

    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /judges/{judgeId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(judgeId);
      allow update: if isOwner(judgeId) || isAdmin();
    }

    match /judgingAssignments/{assignmentId} {
      allow get: if isAdmin() ||
        (isAuthenticated() && resource.data.judgeId == request.auth.uid);
      allow list: if isAdmin() ||
        (isAuthenticated() && getUserRole() == 'judge');
      allow create, update, delete: if isAdmin();
    }

    match /judgeScores/{scoreId} {
      allow get: if isAdmin() ||
        (isAuthenticated() && resource.data.judgeId == request.auth.uid);
      allow list: if isAdmin() ||
        (isAuthenticated() && getUserRole() == 'judge');
      allow create: if isAuthenticated() &&
        request.resource.data.judgeId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.judgeId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /specialAwardCandidates/{awardId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /specialAwardAssignments/{assignmentId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.judgeId == request.auth.uid);
      allow list: if isAdmin() ||
        (isAuthenticated() && getUserRole() == 'judge');
      allow create, update, delete: if isAdmin();
    }

    match /specialAwardScores/{scoreId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.judgeId == request.auth.uid);
      allow list: if isAdmin() ||
        (isAuthenticated() && getUserRole() == 'judge');
      allow create: if isAuthenticated() &&
        request.resource.data.judgeId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.judgeId == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
